# Configuración de Entorno para MesaTech Frontend (React)
# Copiar este archivo como .env para desarrollo local o configuración de CI/CD

# Client ID de la SPA registrada en Microsoft Entra ID
REACT_APP_AZURE_CLIENT_ID=your-entra-spa-client-id-here

# Tenant ID de Microsoft Entra ID
REACT_APP_AZURE_TENANT_ID=your-azure-tenant-id-here

# URL de Autoridad de Microsoft Entra ID
REACT_APP_AZURE_AUTHORITY=https://login.microsoftonline.com/your-azure-tenant-id-here

# Scope de la API expuesto en 'api-cloud-native'
REACT_APP_API_SCOPE=api://api-cloud-native/access_as_user

# URL pública de AWS API Gateway (o BFF directo http://localhost:8080)
REACT_APP_API_GATEWAY_URL=http://localhost:8080
